# Django
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-with-a-real-key

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Space-Track.org credentials (free account at https://www.space-track.org/auth/createAccount)
SPACETRACK_USER=your@email.com
SPACETRACK_PASS=yourpassword

# Redis — use redis://localhost:6379/0 for local dev
#         use redis://redis:6379/0    when running via Docker Compose
REDIS_URL=redis://localhost:6379/0
